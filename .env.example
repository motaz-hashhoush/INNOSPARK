# Database
DATABASE_URL=postgresql://postgres:postgres@host.docker.internal:5432/innospark

# JWT Auth
SECRET_KEY=change-this-to-a-secure-random-string-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# File Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50

# AI Model
AI_MODEL_NAME=all-MiniLM-L6-v2

# PostgreSQL
POSTGRES_USER=innospark
POSTGRES_PASSWORD=innospark_pass
POSTGRES_DB=innospark_db
