# Database
DATABASE_URL=postgresql://innospark:innospark_pass@localhost:5432/innospark_db

# JWT Auth
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# File Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50

# AI Model
AI_MODEL_NAME=all-MiniLM-L6-v2

# Outgoing email — contact requests go to innopark@najah.edu (leave SMTP_HOST empty to only log)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM=innospark@najah.edu
